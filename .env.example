# SkillForge .env example — copy to .env and fill values. Missing required vars
# abort startup (envRequired in cmd/server/main.go logs
# "[FAIL] cmd/server: <VAR> env var not set (copy .env.example to .env and
# populate)" and exits non-zero). docker-compose.yml adds a second ${VAR:?}
# fail-fast layer so compose itself refuses to start without GLM_API_KEY /
# BGE_M3_URL. NEVER commit real secrets — .env is gitignored.

# Retriever backend selection (optional). Default: milvus.
#   milvus — production path (Milvus v2.4+ gRPC, tier-filtered IVF_FLAT cosine).
#   mongo  — MongoDB 4.4+ fallback (no native vector search; tier filter via
#            {tier:{$in}} query, cosine computed in Go against the matched rows).
#            Set MONGO_URI when backend=mongo. MILVUS_ADDRESS becomes optional.
RETRIEVER_BACKEND=milvus

# Milvus (compose service name; for non-compose deploys use host:19530).
# Required when RETRIEVER_BACKEND=milvus (default).
MILVUS_ADDRESS=milvus:19530
MILVUS_TOKEN=

# MongoDB — required when RETRIEVER_BACKEND=mongo. Standard connection URI;
# SkillForge connects with default read preference (primary). The database
# and collection are fixed (skillforge.knowledge) — see cmd/server/main.go.
# Examples:
#   MONGO_URI=mongodb://localhost:27017
#   MONGO_URI=mongodb://user:pass@host:27017/?authSource=admin
MONGO_URI=

# BGE-M3 embedding (user-supplied). Local minimum:
#   ollama pull bge-m3   then use the default URL below.
# Required in both backends. OpenAI-compatible /v1/embeddings endpoint.
#
# DOCKER USERS: "localhost" inside the backend container is NOT your host.
# If you run BGE-M3 via `ollama` on the host, use host.docker.internal:
#   BGE_M3_URL=http://host.docker.internal:11434/v1/embeddings   (Docker Desktop)
# Otherwise BGE-M3 stays unreachable and every query silently refuses
# (no_authorized_source) with no error in the backend log.
BGE_M3_URL=http://localhost:11434/v1/embeddings
# BGE_M3_MODEL — model name sent in the {"model","input"} request body.
# Ollama's OpenAI-compatible /v1/embeddings REQUIRES this (set to your
# ollama model tag). vLLM/TEI accept it. Default: bge-m3.
BGE_M3_MODEL=bge-m3
BGE_M3_AUTH=

# GLM Coding Plan endpoint (公网; LLM + judge). Required.
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# Phase 3 audit + session-memory backend (Plan 03-02). Pure-Go SQLite
# (modernc.org/sqlite, no cgo). Default "skillforge.db" produces a
# durable audit trail next to the binary; ":memory:" is the test path.
SQLITE_DSN=skillforge.db
