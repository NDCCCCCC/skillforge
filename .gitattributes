# Normalize all text files to LF in the repository.
* text=auto

# Source and config files always LF in working tree (gofmt-clean on any OS).
*.go     text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
*.md     text eol=lf
*.json   text eol=lf
*.yml    text eol=lf
*.yaml   text eol=lf
*.ts     text eol=lf
*.tsx    text eol=lf
*.css    text eol=lf
*.js     text eol=lf
*.sh     text eol=lf
*.sql    text eol=lf
Dockerfile*    text eol=lf
*.dockerignore text eol=lf

# Binaries — never normalize.
*.png binary
*.gif binary
*.db  binary

# Phase 15 decode-pipeline fixtures — byte-exact encodings (GBK / GB18030 /
# BOM variants); EOL normalization would silently change what they test.
internal/data/testdata/*.csv -text
*.jsonl text eol=lf
