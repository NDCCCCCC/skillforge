# SkillForge backend image — multi-stage Go build (D7-04 source build).
#
# Both stages are glibc-based on purpose. The static duckdb archive linked by
# CGO references glibc symbols — `backtrace`, `backtrace_symbols`,
# `malloc_trim`, `__res_init` — that the image's libc must provide. A non-glibc
# base cannot link the archive (undefined references at build time) and cannot
# satisfy the C++ engine's runtime library dependencies.
#
# Build stage: golang:1.25-bookworm (the official Debian-based Go image carries
# gcc/g++/make, so CGO needs no extra toolchain install). Matches go.mod
# `go 1.25.5`.
# Runtime stage: debian:bookworm-slim + ca-certificates + tzdata + libstdc++6
# + libgcc-s1 + the CGO binary + skills/ + knowledge/ (runtime data the loader
# + indexer scan).
# CGO_ENABLED=1 required: go-duckdb + mattn/go-sqlite3 link C engines
# (see Makefile check-cgo / MSYS2 guidance for local Windows builds).
# All base images are pinned to specific tags (T-7-OSS-CONTAINER mitigation).

# ---------- build stage ----------
FROM golang:1.25-bookworm AS builder
WORKDIR /src
# Copy deps first to leverage the layer cache (go.sum is committed).
COPY go.mod go.sum ./
RUN go mod download
# Bring in the rest of the source (build context is bounded by .dockerignore:
# backend source + skills/ + knowledge/ + web/ only; .planning/ .git/ .env
# *.exe node_modules/ web/dist/ are excluded).
COPY . .
# CGO build (dynamic, links against the builder's glibc):
#   -trimpath       strips $GOPATH / build-machine paths from the binary
#   -ldflags="-s -w" strips debug symbols + DWARF table
#   CGO_ENABLED=1    links the duckdb + sqlite3 C engines; the runtime stage is
#                    Debian bookworm (glibc present) so the binary runs as-is.
#                    Do NOT switch the runtime to distroless/scratch or to a
#                    non-glibc base without an explicit static-link story
#                    (T-14-21).
RUN CGO_ENABLED=1 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/skillforge ./cmd/server

# ---------- runtime stage ----------
FROM debian:bookworm-slim
# ca-certificates: the backend dials GLM (https) + the embedding endpoint (https).
# tzdata: audit timestamps render in the local zone regardless of container UTC.
# libstdc++6/libgcc-s1: go-duckdb v2.4.3's C++ engine is dynamically linked
# against libstdc++.so.6 (libgcc-s1 rides along). They are runtime
# requirements, not build-only: an image without them dies at docker-run load
# time with "not found" before any Go code runs (CR-01, 14-11 Gap 2).
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates tzdata libstdc++6 libgcc-s1 && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY --from=builder /out/skillforge /app/skillforge
# Runtime data — the Phase 2 cmd/server/main.go hardcodes these relative
# paths: skill.NewLoader("skills/") + knowledge.Index over "knowledge/".
# Shipping them in the image means `docker compose up` works without a
# volume mount for the demo corpus.
COPY skills/ /app/skills/
COPY knowledge/ /app/knowledge/
EXPOSE 8888
ENTRYPOINT ["/app/skillforge"]
