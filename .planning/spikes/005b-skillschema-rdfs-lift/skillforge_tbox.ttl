# SkillForge TBox (auto-generated by spike 005b)
# Source: SKILL.md frontmatter + ./knowledge/{5-tier}/ subdirectory walk

@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix skf:  <http://skillforge.local/ontology#> .

# === Classes ===
skf:Tier a owl:Class ;
    rdfs:label "Tier" ;
    rdfs:comment "Trust tier for KB content (权威/历史/个人/sql-guides/draft)." .

skf:KBCategory a owl:Class ;
    rdfs:label "KB Category" ;
    rdfs:comment "A top-level category within a Tier." .

skf:SubCategory a owl:Class ;
    rdfs:label "SubCategory" ;
    rdfs:comment "A sub-directory within a KB Category (e.g. 取数口径 / 操作手册 / 汽车险)." .

skf:Skill a owl:Class ;
    rdfs:label "Skill" ;
    rdfs:comment "A SkillForge skill — a self-contained agent workflow declared by SKILL.md." .

skf:SkillAgent a owl:Class ;
    rdfs:label "Skill Agent Type" ;
    rdfs:comment "The agent type that powers a Skill (ChatModelAgent, ReActAgent, Sequential, Parallel, Loop)." .

skf:RefusalPhrase a owl:Class ;
    rdfs:label "Refusal Phrase" ;
    rdfs:comment "A refusal phrase a Skill is required to emit under specified conditions." .

# === Object Properties ===
skf:belongsToTier a owl:ObjectProperty ;
    rdfs:domain skf:KBCategory ;
    rdfs:range skf:Tier ;
    rdfs:label "category belongs to tier" .

skf:hasSubCategory a owl:ObjectProperty ;
    rdfs:domain skf:KBCategory ;
    rdfs:range skf:SubCategory ;
    rdfs:label "category has sub-category" .

skf:hasReadAccess a owl:ObjectProperty ;
    rdfs:domain skf:Skill ;
    rdfs:range skf:KBCategory ;
    rdfs:label "skill reads from category" .

skf:hasWriteAccess a owl:ObjectProperty ;
    rdfs:domain skf:Skill ;
    rdfs:range skf:KBCategory ;
    rdfs:label "skill writes to category" .

skf:poweredBy a owl:ObjectProperty ;
    rdfs:domain skf:Skill ;
    rdfs:range skf:SkillAgent ;
    rdfs:label "skill powered by agent type" .

skf:requiresRefusal a owl:ObjectProperty ;
    rdfs:domain skf:Skill ;
    rdfs:range skf:RefusalPhrase ;
    rdfs:label "skill requires refusal phrase" .

# === Datatype Properties ===
skf:skillName a owl:DatatypeProperty ;
    rdfs:domain skf:Skill ;
    rdfs:range xsd:string ;
    rdfs:label "skill name" .

skf:skillDescription a owl:DatatypeProperty ;
    rdfs:domain skf:Skill ;
    rdfs:range xsd:string ;
    rdfs:label "skill description" .

skf:skillTemperature a owl:DatatypeProperty ;
    rdfs:domain skf:Skill ;
    rdfs:range xsd:decimal ;
    rdfs:label "skill LLM temperature" .

skf:categoryName a owl:DatatypeProperty ;
    rdfs:domain skf:KBCategory ;
    rdfs:range xsd:string ;
    rdfs:label "category name" .

skf:subCategoryName a owl:DatatypeProperty ;
    rdfs:domain skf:SubCategory ;
    rdfs:range xsd:string ;
    rdfs:label "sub-category name" .

skf:tierName a owl:DatatypeProperty ;
    rdfs:domain skf:Tier ;
    rdfs:range xsd:string ;
    rdfs:label "tier name" .

skf:agentTypeName a owl:DatatypeProperty ;
    rdfs:domain skf:SkillAgent ;
    rdfs:range xsd:string ;
    rdfs:label "agent type name" .

skf:refusalPhraseText a owl:DatatypeProperty ;
    rdfs:domain skf:RefusalPhrase ;
    rdfs:range xsd:string ;
    rdfs:label "refusal phrase text" .

# === ABox: Tier instances ===
skf:authority a skf:Tier ; skf:tierName "authority" .

skf:draft a skf:Tier ; skf:tierName "draft" .

skf:historical a skf:Tier ; skf:tierName "historical" .

skf:personal a skf:Tier ; skf:tierName "personal" .

skf:sql-guides a skf:Tier ; skf:tierName "sql-guides" .

# === ABox: KB Category + SubCategory instances ===
skf:cat_authority a skf:KBCategory ;
    skf:categoryName "authority" ;
    skf:belongsToTier skf:authority .

skf:cat_draft a skf:KBCategory ;
    skf:categoryName "draft" ;
    skf:belongsToTier skf:draft .

skf:cat_historical a skf:KBCategory ;
    skf:categoryName "historical" ;
    skf:belongsToTier skf:historical .

skf:cat_personal a skf:KBCategory ;
    skf:categoryName "personal" ;
    skf:belongsToTier skf:personal .

skf:cat_sql-guides a skf:KBCategory ;
    skf:categoryName "sql-guides" ;
    skf:belongsToTier skf:sql-guides .

skf:sub_sql-guides_其他 a skf:SubCategory ;
    skf:subCategoryName "其他" ;
    skf:hasSubCategory skf:sub_sql-guides_其他 .

skf:sub_sql-guides_取数口径 a skf:SubCategory ;
    skf:subCategoryName "取数口径" ;
    skf:hasSubCategory skf:sub_sql-guides_取数口径 .

skf:sub_sql-guides_操作手册 a skf:SubCategory ;
    skf:subCategoryName "操作手册" ;
    skf:hasSubCategory skf:sub_sql-guides_操作手册 .

skf:sub_sql-guides_汽车险 a skf:SubCategory ;
    skf:subCategoryName "汽车险" ;
    skf:hasSubCategory skf:sub_sql-guides_汽车险 .

skf:sub_sql-guides_理赔与赔付 a skf:SubCategory ;
    skf:subCategoryName "理赔与赔付" ;
    skf:hasSubCategory skf:sub_sql-guides_理赔与赔付 .

skf:sub_sql-guides_财务对账 a skf:SubCategory ;
    skf:subCategoryName "财务对账" ;
    skf:hasSubCategory skf:sub_sql-guides_财务对账 .

skf:sub_sql-guides_非车险 a skf:SubCategory ;
    skf:subCategoryName "非车险" ;
    skf:hasSubCategory skf:sub_sql-guides_非车险 .

# === ABox: Skill instances ===
skf:agent_ReActAgent a skf:SkillAgent ;
    skf:agentTypeName "ReActAgent" .

skf:skill_calculator a skf:Skill ;
    skf:skillName "calculator" ;
    skf:skillDescription "算术 / 计算 (arithmetic / calculation). Triggers when the user asks a pure numeric question such as \"2+2\", \"monthly interest on 10000 at 5%\", or \"convert 17/25 to a percentage\". Does NOT handle questions that require citing retrieved documents — calculator is a tool-only Skill and never reads from any knowledge tier." ;
    skf:skillTemperature "0.00"^^xsd:decimal ;
    skf:poweredBy skf:agent_ReActAgent .

skf:skill_calculator skf:hasReadAccess skf:cat_draft .
skf:phrase_non_arithmetic_query a skf:RefusalPhrase ; skf:refusalPhraseText "non_arithmetic_query" .

skf:skill_calculator skf:requiresRefusal skf:phrase_non_arithmetic_query .

skf:agent_ChatModelAgent a skf:SkillAgent ;
    skf:agentTypeName "ChatModelAgent" .

skf:skill_compliance a skf:Skill ;
    skf:skillName "compliance" ;
    skf:skillDescription "企业合规/制度审查。当用户问\"这个报销合规吗\"、\"这个条款怎么解读\"、\"出差住宿费超标\"、\"竞业限制期\"、\"年假折算\"、\"合同审批权限\"等企业内部合规问题时触发。事实型查询（\"X 由谁审批\"、\"X 有几天\"、\"X 多久\"）也通过此 Skill 处理 —— 答案放在 `answer` 字段。不处理外部法律法规咨询、销售话术、营销文案或个人隐私信息查询。" ;
    skf:skillTemperature "0.00"^^xsd:decimal ;
    skf:poweredBy skf:agent_ChatModelAgent .

skf:skill_compliance skf:hasReadAccess skf:cat_authority .
skf:phrase_no_authorized_source a skf:RefusalPhrase ; skf:refusalPhraseText "no_authorized_source" .

skf:skill_compliance skf:requiresRefusal skf:phrase_no_authorized_source .
skf:phrase_out_of_scope a skf:RefusalPhrase ; skf:refusalPhraseText "out_of_scope" .

skf:skill_compliance skf:requiresRefusal skf:phrase_out_of_scope .
skf:phrase_low_retrieval_score a skf:RefusalPhrase ; skf:refusalPhraseText "low_retrieval_score" .

skf:skill_compliance skf:requiresRefusal skf:phrase_low_retrieval_score .

skf:agent_orchestrator a skf:SkillAgent ;
    skf:agentTypeName "orchestrator" .

skf:skill_compliance-orchestrator a skf:Skill ;
    skf:skillName "compliance-orchestrator" ;
    skf:skillDescription "企业合规多跳检索编排（orchestrator 父 Skill）。当用户问题需要跨多个制度主题组合证据（如「关联方认定 + 董事会审批触发」「差旅政策 + 总经理审批阈值」）时触发：classifier 拆分 2-3 个 sub-query，扇出只读子 agent 并行检索，保守合并后输出单一 verdict。单点事实查询路由到 compliance Skill；本 Skill 不处理任何写操作，子 agent 结构性只读。" ;
    skf:skillTemperature "0.00"^^xsd:decimal ;
    skf:poweredBy skf:agent_orchestrator .

skf:skill_compliance-orchestrator skf:hasReadAccess skf:cat_authority .
skf:skill_compliance-orchestrator skf:hasReadAccess skf:cat_historical .
skf:skill_compliance-orchestrator skf:requiresRefusal skf:phrase_no_authorized_source .
skf:phrase_tier_intersection_empty a skf:RefusalPhrase ; skf:refusalPhraseText "tier_intersection_empty" .

skf:skill_compliance-orchestrator skf:requiresRefusal skf:phrase_tier_intersection_empty .
skf:skill_compliance-orchestrator skf:requiresRefusal skf:phrase_low_retrieval_score .

skf:agent_chat a skf:SkillAgent ;
    skf:agentTypeName "chat" .

skf:skill_external-lookup a skf:Skill ;
    skf:skillName "external-lookup" ;
    skf:skillDescription "外部授权数据查询（个体级）。触发场景：需要查某个员工/客户的个体级记录（如上月消费明细、账号、联系方式），且数据在预编译视图内。先经数据人员审批，再返回按视图掩码规则脱敏的行。" ;
    skf:skillTemperature "0.30"^^xsd:decimal ;
    skf:poweredBy skf:agent_chat .

skf:phrase_no_data a skf:RefusalPhrase ; skf:refusalPhraseText "no_data" .

skf:skill_external-lookup skf:requiresRefusal skf:phrase_no_data .

skf:skill_kpi-dashboard a skf:Skill ;
    skf:skillName "kpi-dashboard" ;
    skf:skillDescription "业务数字问答。触发短语：「贷款余额」「不良率」「客户数」「上月销售额」等聚合数字问题。返回数值 + KPI 定义 + 计算时间窗 + as_of + 数据引用。" ;
    skf:skillTemperature "0.00"^^xsd:decimal ;
    skf:poweredBy skf:agent_ChatModelAgent .

skf:phrase_no_matching_kpi a skf:RefusalPhrase ; skf:refusalPhraseText "no_matching_kpi" .

skf:skill_kpi-dashboard skf:requiresRefusal skf:phrase_no_matching_kpi .
skf:phrase_dataset_not_available a skf:RefusalPhrase ; skf:refusalPhraseText "dataset_not_available" .

skf:skill_kpi-dashboard skf:requiresRefusal skf:phrase_dataset_not_available .

skf:agent_deep a skf:SkillAgent ;
    skf:agentTypeName "deep" .

skf:skill_monthly-report a skf:Skill ;
    skf:skillName "monthly-report" ;
    skf:skillDescription "业务月报生成。当用户说「出月报」「2026-08 月报」「生成月度报告」时触发。" ;
    skf:skillTemperature "0.00"^^xsd:decimal ;
    skf:poweredBy skf:agent_deep .

skf:phrase_period_not_found a skf:RefusalPhrase ; skf:refusalPhraseText "period_not_found" .

skf:skill_monthly-report skf:requiresRefusal skf:phrase_period_not_found .
skf:phrase_insufficient_kpi_data a skf:RefusalPhrase ; skf:refusalPhraseText "insufficient_kpi_data" .

skf:skill_monthly-report skf:requiresRefusal skf:phrase_insufficient_kpi_data .

skf:skill_simple-qa a skf:Skill ;
    skf:skillName "simple-qa" ;
    skf:skillDescription "通用问答 / general Q&A. Triggers when the user asks a factual question that should be answered from the authority knowledge tier (e.g. \"what does the policy say about X\", \"summarize the rule on Y\"). Does NOT handle compliance verdicts with citation spans (use the `compliance` Skill for that), arithmetic / calculator queries, or any request involving personal information about a specific individual." ;
    skf:skillTemperature "0.30"^^xsd:decimal ;
    skf:poweredBy skf:agent_ChatModelAgent .

skf:skill_simple-qa skf:hasReadAccess skf:cat_authority .
skf:phrase_no_relevant_source a skf:RefusalPhrase ; skf:refusalPhraseText "no_relevant_source" .

skf:skill_simple-qa skf:requiresRefusal skf:phrase_no_relevant_source .

skf:skill_sql-guides a skf:Skill ;
    skf:skillName "sql-guides" ;
    skf:skillDescription "SQL 取数/操作手册检索。当用户问「这条 SQL 怎么写」「取数口径是什么」「字段含义」「存储过程」「某个表的取数」「某个险种的保费/赔款怎么提数」等数据库操作问题时触发。返回操作步骤 + 原文 SQL + 涉及表/字段提示，**不参与合规引用裁决**。" ;
    skf:skillTemperature "0.00"^^xsd:decimal ;
    skf:poweredBy skf:agent_ChatModelAgent .

skf:skill_sql-guides skf:hasReadAccess skf:cat_sql-guides .
skf:phrase_no_matching_guide a skf:RefusalPhrase ; skf:refusalPhraseText "no_matching_guide" .

skf:skill_sql-guides skf:requiresRefusal skf:phrase_no_matching_guide .
skf:skill_sql-guides skf:requiresRefusal skf:phrase_out_of_scope .

