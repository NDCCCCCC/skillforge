# SkillForge frontend image — multi-stage Vite build -> nginx static serve
# (D7-04 source build).
#
# Build stage: node:22-alpine (matches web/package.json @types/node ^22,
# vite ^5.4.0, ai ^7.0.59). Runtime stage: nginx:1.27-alpine serving the
# Vite build output (web/dist/) with an /api reverse proxy to the backend
# compose service. proxy_buffering OFF is load-bearing for UIMessageChunk
# SSE streaming — without it nginx buffers chunks and the trust UI degrades
# to a single flushed blob at connection close.
# All base images are pinned to specific tags (T-7-OSS-CONTAINER mitigation).

# ---------- build stage ----------
FROM node:22-alpine AS builder
WORKDIR /web
# Copy deps first to leverage the layer cache. package-lock.json is committed.
COPY web/package.json web/package-lock.json ./
RUN npm ci
# Bring in the rest of the frontend source (build context bounded by
# .dockerignore: web/src/, web/package.json, web/index.html etc. are kept;
# web/node_modules/ and web/dist/ are excluded so they don't shadow the
# in-image build).
COPY web/ .
# `vite build` emits web/dist/ (Vite default outDir; see web/vite.config.ts).
RUN npm run build

# ---------- runtime stage ----------
FROM nginx:1.27-alpine
# Copy the Vite build output into the nginx document root.
COPY --from=builder /web/dist /usr/share/nginx/html
# nginx default.conf:
#   - SPA fallback: try_files $uri -> /index.html (React Router client routes)
#   - /api reverse proxy -> backend:8888 (compose service DNS)
#   - proxy_buffering off + Connection "" -> unbuffered HTTP/1.1 upstream,
#     required for SSE streaming of UIMessageChunk frames.
#   - proxy_read/send_timeout 3600s -> override nginx's default 60s read
#     timeout so a long compliance chain-of-thought (>60s to first token)
#     is NOT cut mid-stream (the trust-verdict SSE flow is the headline UX).
#     Using a single printf keeps this a self-contained Dockerfile (no bundled nginx.conf).
RUN printf 'server {\n  listen 80;\n  root /usr/share/nginx/html;\n  location / { try_files $uri /index.html; }\n  location /api { proxy_pass http://backend:8888; proxy_http_version 1.1; proxy_set_header Connection ""; proxy_buffering off; proxy_read_timeout 3600s; proxy_send_timeout 3600s; }\n}\n' > /etc/nginx/conf.d/default.conf
EXPOSE 80
